# Maintainer: DankC
pkgname=dankc
pkgver=0.0.1
pkgrel=1
pkgdesc="Lightweight C Wayland shell for niri (DankMaterialShell rewrite)"
arch=('x86_64' 'aarch64')
url="https://github.com/AvengeMedia/DankMaterialShell"
license=('MIT')
depends=(
  'wayland' 'libxkbcommon' 'systemd-libs' 'mesa' 'pam'
  # Fontconfig-located script fallbacks dankc's own renderer loads at startup
  # (src/render/nvg.c FALLBACK_SPECS) — Latin/Cyrillic/Greek/Arabic/Urdu/
  # Devanagari/Thai and most other scripts, plus everything GTK/Qt/browsers
  # need for the same languages system-wide (see packaging/fontconfig).
  'noto-fonts'
  # CJK (Chinese/Japanese/Korean) fallback; not covered by noto-fonts.
  'noto-fonts-cjk'
  # Latin/symbol safety net: last-resort fallback if a Noto face is somehow
  # missing/uninstalled, both for dankc's own chain and system-wide.
  'ttf-dejavu'
)
makedepends=('meson' 'ninja' 'wayland-protocols' 'pkgconf')
optdepends=(
  'wireplumber: volume control (wpctl)'
  'brightnessctl: brightness control'
  'bluez: bluetooth status'
  'wl-clipboard: clipboard history + copy-back'
  'grim: screenshots'
  'slurp: region screenshot + color picker'
  'gammastep: night mode / warm filter'
  'noto-fonts-emoji: color emoji in browsers/GTK/Qt apps (system-wide fontconfig fallback only — dankc'"'"'s own renderer is monochrome-only and vendors its own NotoEmoji subset, see src/render/nvg.c)'
)
# For a release, point source at a tagged tarball/commit and set sha256sums.
# Local build: run `makepkg` from a checkout, or just use the Makefile / meson
# directly (see packaging/README.md).
source=()
sha256sums=()

build() {
  # Explicit debug=false + b_ndebug=true + optimization=2 (rather than
  # --buildtype=release, which implies -O3): -O3's more aggressive inlining,
  # combined with meson.build's project-wide b_lto=true, triggers
  # false-positive -Wstringop-overflow/-Wstringop-overread warnings (a known
  # GCC diagnostic issue at higher optimization levels, seen both in vendored
  # third_party/nanovg's bundled stb_image.h and in src/services/apps.c) that
  # don't appear at -O2. -O2 matches the Makefile's release profile and is
  # plenty for this codebase; this combo still drops -g and adds -DNDEBUG on
  # top of the b_lto=true set in meson.build, so the packaged binary is the
  # fully optimized, non-debug, LTO'd, warning-clean build.
  arch-meson "$srcdir/.." build -Doptimization=2 -Ddebug=false -Db_ndebug=true
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  # T1.3: strip the installed binary to reduce disk footprint (debug_info only, no RAM impact)
  strip "$pkgdir/usr/local/bin/dankc" || strip "$pkgdir/usr/bin/dankc" 2>/dev/null || true

  # System-wide fontconfig fallback (browsers/GTK/Qt apps), see
  # packaging/fontconfig/49-dankc-fonts.conf and packaging/README.md.
  # $startdir is the directory containing this PKGBUILD (packaging/),
  # always correct regardless of BUILDDIR — unlike $srcdir, which moves.
  install -Dm644 "$startdir/fontconfig/49-dankc-fonts.conf" \
    "$pkgdir/etc/fonts/conf.d/49-dankc-fonts.conf"
}
